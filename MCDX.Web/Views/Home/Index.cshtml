@model MCDX.Web.Models.OperationsDashboardViewModel
@{
    ViewData["Title"] = Model.PageTitle;
    var topMap = new Dictionary<string, string>
    {
        ["Dashboard"] = "Dashboard",
        ["Facilities"] = "Facilities",
        ["Tools"] = "Tools",
        ["BladeExchange"] = "Tools",
        ["WorkLogs"] = "WorkLogs",
        ["LoadSummary"] = "LoadSummary",
        ["Ranking"] = "Ranking",
        ["Settings"] = "Settings"
    };
    var activeTop = topMap.TryGetValue(Model.ActiveSection, out var mappedTop) ? mappedTop : "Dashboard";
    ViewData["ActiveTop"] = activeTop;

    var menuMap = new Dictionary<string, string[]>
    {
        ["Dashboard"] = ["設備ステータス", "負荷予測", "サイト比較", "連絡事項", "クイックメニュー"],
        ["Facilities"] = ["設備一覧", "設備グループ", "設備カレンダー", "保全履歴", "予備品管理"],
        ["Tools"] = ["刃物リスト", "刃具交換リスト", "工具在庫", "工具グループ", "工具マスタ"],
        ["WorkLogs"] = ["作業記録一覧", "点検記録", "申し送り", "作業者別履歴", "承認待ち"],
        ["LoadSummary"] = ["負荷サマリ", "負荷カレンダー", "設備別負荷", "負荷予測", "計画シミュレーション"],
        ["Ranking"] = ["個人ランキング", "チームランキング", "改善提案", "設備稼働", "月次表彰"],
        ["Settings"] = ["サイト設定", "ユーザー管理", "権限設定", "通知条件", "外部連携"]
    };
    var sideItems = menuMap[activeTop];
    var menuTitle = activeTop == "Tools" ? "工具メニュー" : $"{Model.PageTitle} メニュー";
    var sideActionMap = new Dictionary<string, string>
    {
        ["設備一覧"] = "Facilities",
        ["刃物リスト"] = "Tools",
        ["刃具交換リスト"] = "BladeExchange",
        ["負荷サマリ"] = "LoadSummary",
        ["個人ランキング"] = "Ranking",
        ["サイト設定"] = "Settings"
    };
}

<div class="workspace">
    <aside class="sidebar">
        @if (activeTop is "Dashboard" or "Facilities")
        {
            <div class="side-title">サイト選択</div>
            @foreach (var site in Model.Sites)
            {
                <section class="site-card @(site.Name == "阿久比" ? "active" : "")">
                    <div class="site-photo"></div>
                    <div>
                        <strong>@site.Name</strong>
                        <span>@site.State</span>
                        <small>稼働率 @site.OperationRate% / アラーム @site.Alarms 件</small>
                    </div>
                </section>
            }
        }

        <div class="side-title mt-4">@menuTitle</div>
        @foreach (var item in sideItems)
        {
            var action = sideActionMap.TryGetValue(item, out var mappedAction) ? mappedAction : "";
            var isActive = action == Model.ActiveSection || (Model.ActiveSection == "Dashboard" && item == "設備ステータス");
            <a class="side-link @(isActive ? "active" : "")" href="@(string.IsNullOrEmpty(action) ? "#" : Url.Action(action, "Home"))">@item</a>
        }
        <a class="back-link" asp-action="Index">← ダッシュボードに戻る</a>
    </aside>

    <section class="content">
        <div class="page-head">
            <div>
                <h1>@Model.PageTitle</h1>
                <p>@Model.PageSubtitle</p>
            </div>
            <div class="head-actions">
                <span>2024/05/27（月） 08:45 更新</span>
                <button type="button">フィルター</button>
                <button type="button" class="primary">+ 新規登録</button>
            </div>
        </div>

        @if (Model.ActiveSection == "Dashboard")
        {
            <section class="home-dashboard home-dashboard-v5">
                <article class="panel equipment-status">
                    <div class="panel-head">
                        <h2>設備ステータス（阿久比）</h2>
                        <a href="#">詳細一覧へ ›</a>
                    </div>
                    <div class="status-counts">
                        <div><span>稼働中</span><strong>22</strong></div>
                        <div><span>停止中</span><strong>2</strong></div>
                        <div><span>アラーム</span><strong>1</strong></div>
                        <div><span>メンテ中</span><strong>3</strong></div>
                    </div>
                    <div class="machine-mini-grid">
                        @foreach (var machine in Model.Machines.Take(12))
                        {
                            var tone = machine.Status == "アラーム" ? "danger" : machine.Status == "停止中" ? "warn" : machine.Status == "メンテ中" ? "info" : "good";
                            <div class="machine-mini @tone">
                                <b>@machine.Code</b>
                                <span>@machine.Status</span>
                                <i>@machine.OperationRate%</i>
                            </div>
                        }
                    </div>
                </article>

                <article class="panel load-forecast">
                    <div class="panel-head"><h2>負荷予測（阿久比）</h2><span>日次</span></div>
                    <div class="line-chart">
                        <span style="height:22%"></span><span style="height:34%"></span><span style="height:47%"></span>
                        <span style="height:58%"></span><span style="height:69%"></span><span style="height:86%"></span>
                        <span style="height:74%"></span><span style="height:61%"></span><span style="height:52%"></span>
                    </div>
                    <div class="chart-footer"><b>ピーク 96%</b><b>15:00</b><b>注意</b></div>
                </article>

                <article class="panel load-actual">
                    <div class="panel-head"><h2>今日の作業スコア（阿久比）</h2><span>ランク B</span></div>
                    <div class="actual-meter">78<span>点</span></div>
                    <div class="actual-bars">
                        <div><span>稼働率</span><i style="width:92%"></i></div>
                        <div><span>段取り達成</span><i style="width:100%"></i></div>
                        <div><span>工具寿命</span><i style="width:85%"></i></div>
                    </div>
                </article>

                <article class="panel site-load">
                    <h2>サイト別負荷</h2>
                    @foreach (var site in Model.Sites)
                    {
                        <div class="summary-row"><span>@site.Name</span><b>@site.OperationRate%</b><i style="width:@site.OperationRate%"></i></div>
                    }
                    <a class="panel-link" href="#">サイト比較を見る ›</a>
                </article>

                <article class="panel notices">
                    <h2>みんなの改善アイデア</h2>
                    <div class="notice-card">
                        <b>佐藤 一郎</b>
                        <p>治具の固定位置を少し変更すると、段取り時間を約15%短縮できます。</p>
                    </div>
                    <div class="notice-card">
                        <b>鈴木 花子</b>
                        <p>チップ交換タイミングを可視化して、交換忘れを防ぎます。</p>
                    </div>
                    <a class="panel-link" href="#">もっと見る ›</a>
                </article>

                <article class="panel fun-panel">
                    <div class="lucky-box">
                        <h2>ラッキーパーソンくじ</h2>
                        <div class="fortune-slip-preview">本日の相談相手</div>
                        <button type="button" data-lucky-open>くじを開く</button>
                    </div>
                    <div class="gacha-box mini-gacha">
                        <h2>工具ガチャ</h2>
                        <div class="gacha-machine">
                            <span class="capsule rare"></span>
                            <span class="capsule super"></span>
                        </div>
                        <button type="button" class="primary gacha-open" data-gacha-open>ガチャを回す</button>
                    </div>
                </article>

                <article class="panel ranking-panel">
                    <div class="panel-head"><h2>ランキング</h2><a asp-action="Ranking">ランキングページへ ›</a></div>
                    <ol class="ranking-list">
                        <li><span class="crown">1</span><b>山田 太郎</b><em>1,245 pt</em></li>
                        <li><span>2</span><b>鈴木 一郎</b><em>1,128 pt</em></li>
                        <li><span>3</span><b>佐藤 花子</b><em>1,085 pt</em></li>
                        <li><span>4</span><b>田中 美咲</b><em>1,022 pt</em></li>
                    </ol>
                </article>

                <article class="panel quick-panel">
                    <h2>クイックメニュー</h2>
                    <div class="quick-actions">
                        <a href="#">作業記録をつける</a>
                        <a href="#">設備状況を確認</a>
                        <a href="#">工具寿命を確認</a>
                        <a href="#">改善を投稿する</a>
                        <a href="#">トラブル報告する</a>
                        <a href="#">教育資料を見る</a>
                    </div>
                </article>

                <article class="panel bottom-notice">
                    <h2>お知らせ</h2>
                    <p>【開始】MC 03にアラームが発生しています。保全チームが対応中です。</p>
                    <a class="panel-link" href="#">すべてのお知らせを見る ›</a>
                </article>
            </section>

            <div class="gacha-modal" data-gacha-modal aria-hidden="true">
                <div class="gacha-dialog">
                    <button type="button" class="modal-close" data-gacha-close>×</button>
                    <div class="summon-stage" data-summon-stage>
                        <div class="burst"></div>
                        <div class="modal-gacha-machine">
                            <div class="gacha-cap"></div>
                            <div class="gacha-globe">
                                <span class="tool-tsum drill"></span>
                                <span class="tool-tsum mill"></span>
                                <span class="tool-tsum chip"></span>
                                <span class="tool-tsum tap"></span>
                                <span class="tool-tsum gauge"></span>
                                <span class="tool-tsum bit"></span>
                            </div>
                            <div class="gacha-body">
                                <i></i>
                            </div>
                            <div class="gacha-ramp"></div>
                        </div>
                        <div class="falling-capsule" data-falling-capsule>
                            <span class="capsule-top"></span>
                            <span class="capsule-bottom"></span>
                        </div>
                        <div class="result-card">
                            <span class="rarity" data-rarity>SSR</span>
                            <div class="blade-art"></div>
                            <h2 data-result-title>伝説級コーティング刃具</h2>
                            <p data-result-text>排出率 3%。今日は工具寿命が伸びそうです。</p>
                        </div>
                    </div>
                    <button type="button" class="primary" data-gacha-roll>もう一度回す</button>
                </div>
            </div>

            <div class="gacha-modal lucky-modal" data-lucky-modal aria-hidden="true">
                <div class="gacha-dialog lucky-dialog">
                    <button type="button" class="modal-close" data-lucky-close>×</button>
                    <div class="fortune-stage" data-fortune-stage>
                        <div class="fortune-paper">
                            <div class="fortune-front">ラッキーパーソンくじ</div>
                            <div class="fortune-result">
                                <span>本日のラッキーパーソン</span>
                                <strong data-lucky-name>鈴木 一郎</strong>
                                <p data-lucky-text>工具交換の相談をすると、段取りがスムーズに進みます。</p>
                            </div>
                        </div>
                    </div>
                    <button type="button" class="primary" data-lucky-roll>もう一度引く</button>
                </div>
            </div>
        }
        else if (Model.ActiveSection == "BladeExchange")
        {
            <partial name="_BladeExchangePanel" model="Model" />
        }
        else if (Model.ActiveSection == "Facilities")
        {
            <partial name="_MachineTable" model="Model" />
        }
        else if (Model.ActiveSection == "Tools")
        {
            <partial name="_ToolTable" model="Model" />
        }
        else if (Model.ActiveSection == "LoadSummary")
        {
            <section class="metric-grid">
                @foreach (var metric in Model.Metrics)
                {
                    <article class="metric-card">
                        <span>@metric.Label</span>
                        <strong>@metric.Value<small>@metric.Unit</small></strong>
                        <em class="@metric.Tone">@metric.Delta</em>
                    </article>
                }
            </section>
            <partial name="_MachineTable" model="Model" />
        }
        else
        {
            <section class="placeholder-grid">
                @foreach (var item in sideItems)
                {
                    <article class="panel placeholder-card">
                        <h2>@item</h2>
                        <p>この画面はあとで作り込みます。</p>
                    </article>
                }
            </section>
        }
    </section>
</div>
